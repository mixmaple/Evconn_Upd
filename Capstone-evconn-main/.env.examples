# ==============================================================================
# REKRU PROFILE WEB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Petunjuk: Salin file ini dan ubah namanya menjadi '.env' di komputer lokal Anda,
# lalu sesuaikan nilai variabel di bawah ini jika diperlukan.
# ==============================================================================

# Konfigurasi Database PostgreSQL
POSTGRES_DB=rekru_profiles
POSTGRES_USER=rekru
POSTGRES_PASSWORD=rekru_password

# Kredensial Akun Default Admin Flask (untuk masuk ke Dashboard)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345

# Key Pengaman Session Flask
SECRET_KEY=change-this-secret-in-production
